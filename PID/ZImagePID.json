          ]
        }
      ],
      "properties": {
        "cnr_id": "comfy-core",
        "ver": "0.24.0",
        "Node name for S&R": "PrimitiveStringMultiline",
        "widget_ue_connectable": {}
      },
      "widgets_values": [
        "{\n  \"場景\": {\n    \"描述\": \"在充滿懷舊氣息的台灣傳統冰果室內，午後陽光灑落，年輕女子正享受著夏日限定的鳳梨剉冰。\",\n    \"環境\": \"復古的白綠相間馬賽克磁磚牆面、牆上掛著老式日曆與旋轉電風扇、玻璃櫃內擺滿新鮮水果、空氣中飄著糖水與水果的甜香。\",\n    \"mood\": \"清涼、復古文青、夏日甜蜜感；懷舊台灣味與現代網美風格的碰撞。\"\n  },\n  \"美學\": {\n    \"風格\": \"高飽和度的日系空氣感攝影，色彩明亮清新。\",\n    \"外觀\": \"明亮的夏日色調（黃色、淺藍、白色），強調清透的膚質感。\"\n  },\n  \"閃電\": {\n    \"描述\": \"自然光從店門口灑入，與店內日光燈混合成明亮均勻的光線；逆光在髮絲邊緣形成光暈；冰品表面有晶瑩剔透的反光點綴。\"\n  },\n  \"主旨\": {\n    \"人口統計\": {\n      \"民族\": \"東亞（台灣/華人）\",\n      \"年齡\": \"20多歲年輕成人\",\n      \"體型\": \"纖細勻稱，充滿夏日活力。\"\n    },\n    \"外貌\": {\n      \"髮型\": \"烏黑柔順的長直髮，自然垂落在肩膀兩側，有些許髮絲勾勒臉龐。\",\n      \"五官\": \"水汪汪的深邃大眼睛，眼神靈動，臉頰因吃冰而帶有自然的紅潤。\",\n      \"皮膚\": \"白皙透亮，帶有夏日的光澤感。\"\n    },\n    \"姿勢\": {\n      \"類型\": \"坐在不鏽鋼桌前，上半身特寫。\",\n      \"動作\": \"身體微前傾，右手拿著裝滿鳳梨冰的金屬湯匙靠近嘴邊（或含著湯匙），眼神看向鏡頭甜笑；左手輕扶著裝冰的玻璃碗。\",\n      \"框架\": \"9:16 豎構圖；中景鏡頭，包含人物上半身與桌上的冰品。\"\n    },\n    \"服裝\": {\n      \"上衣\": \"亮黃色或熱帶花卉圖案的綁帶比基尼上衣，展現夏日熱情。\",\n      \"下裝\": \"淺藍色丹寧短裙，邊緣帶有流蘇設計，休閒且時尚。\"\n    },\n    \"配件\": {\n      \"珠寶\": \"簡約的鎖骨鍊，手腕戴著彩色編織手環。\",\n      \"其他\": \"桌上放著復古玻璃水杯和色彩鮮豔的吸管。\"\n    }\n  },\n  \"道具與場景\": {\n    \"背景\": \"牆上貼著手寫書法字體的價目表，必須包含清晰文字：「古早味」、「鳳梨冰」、「新鮮水果」；背景可見模糊的舊式刨冰機輪廓。\",\n    \"主要道具\": \"復古雕花的大玻璃碗，堆得像小山一樣的剉冰，上面鋪滿金黃色的蜜漬鳳梨塊，淋上濃郁的糖漿與煉乳，視覺上極具誘惑力。\"\n  },\n  \"攝影技術\": {\n    \"要求\": \"強調鳳梨冰的金黃色澤與人物的清新感；文字招牌需具備可辨識度；景深適中，背景虛化但保留環境特徵。\",\n    \"拍攝\": \"Sony A7R IV, 35mm f/1.4 鏡頭, ISO 200, 1/250s, 自然光優先。\",\n    \"構圖\": \"人物位於畫面中央偏下，頭部上方保留空間展示背景招牌文字；引導視線從人物臉部延伸至手中的冰品。\",\n    \"修飾\": \"強化黃色與藍色的對比；保留皮膚毛孔質感不磨皮；強調冰塊的晶瑩剔透感。\",\n    \"避免\": \"過度暴露導致招牌文字不可讀、手指變形、冰品融化過度看起來不美味。\"\n  }\n}"
      ],
      "color": "#232",
      "bgcolor": "#353"
    },
